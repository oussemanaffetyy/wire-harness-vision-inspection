  {
    "id": "whi_history",
    "type": "function",
    "z": "whi_tab",
    "name": "Memoriser les changements",
    "func": "// Node-RED Function node: keep verdict transitions, not one row per video frame.\nconst key = 'whiInspectionV2';\nconst state = context.get(key) || { current: null, history: [] };\nif (msg.topic === 'inspection/request') {\n    return { _client: msg._client, topic: 'inspection/state', payload: { kind: 'inspection', ...state } };\n}\nif (msg.topic !== 'factory/inspection/status') return null;\nconst p = msg.payload;\nif (!p || !['OK', 'NOK'].includes(p.status) || !Number.isFinite(Date.parse(p.timestamp))) return null;\nconst current = {\n    status: p.status, timestamp: p.timestamp,\n    source_name: typeof p.source_name === 'string' ? p.source_name.slice(0, 512) : '',\n    frame_index: Number.isInteger(p.frame_index) ? p.frame_index : null,\n    detail: String((Array.isArray(p.details) && p.details[0]) || p.note || '').slice(0, 512)\n};\nconst previous = state.current;\nconst duplicate = previous && current.timestamp === previous.timestamp &&\n    current.frame_index === previous.frame_index && current.source_name === previous.source_name && current.status === previous.status;\nif (duplicate) return null;\n// A retained MQTT message restores the last verdict but is not a new inspection.\nconst changed = !previous || previous.status !== current.status || previous.source_name !== current.source_name ||\n    (current.frame_index !== null && previous.frame_index !== null && current.frame_index < previous.frame_index);\nstate.current = current;\nconst added = (changed || !state.history.length) && msg.retain !== true;\nif (added) {\n    state.history.unshift({ ...current, id: `${current.timestamp}:${current.source_name}:${current.frame_index}` });\n    state.history = state.history.slice(0, 300);\n}\ncontext.set(key, state);\nreturn { topic: 'inspection/state', payload: {\n    kind: 'inspection', current, ...(added ? { history: state.history } : {})\n} };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 240,
    "wires": [
      [
        "whi_dashboard"
      ]
    ]
  },
  {
    "id": "whi_mqtt_metrics",
    "type": "mqtt in",
    "z": "whi_tab",
    "name": "Compteurs production",
    "topic": "factory/inspection/metrics",
    "qos": "0",
    "datatype": "json",
    "broker": "whi_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 340,
    "wires": [
      [
        "whi_dashboard"
      ]
    ]
